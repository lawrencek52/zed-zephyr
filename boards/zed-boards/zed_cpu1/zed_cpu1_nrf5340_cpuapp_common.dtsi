#include "zed_cpu1_nrf5340_common.dtsi"
#include "zed_cpu1_nrf5340_cpuapp_common-pinctrl.dtsi"
#include "zed_cpu1_nrf5340_con.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,bt-hci = &bt_hci_ipc0;
		nordic,802154-spinel-ipc = &ipc0;
		zephyr,ieee802154 = &ieee802154;
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm3 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
		pwm_led1: pwm_led_1 {
			pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
		pwm_led2: pwm_led_2 {
			pwms = <&pwm3 2 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
	};

/*	gpio_fwd: nrf-gpio-forwarder {
		compatible = "nordic,nrf-gpio-forwarder";
		status = "okay";

		uart {
			gpios = <&gpio1 1 0>, <&gpio1 0 0>, <&gpio0 11 0>, <&gpio0 10 0>;
		};
	};
*/
	/* These aliases are provided for compatibility with samples */
	aliases {
		red-pwm-led = &pwm_led0;
		green-pwm-led = &pwm_led1;
		blue-pwm-led = &pwm_led2;
		watchdog0 = &wdt0;
	};
};

&vregmain {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregradio {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregh {
	status = "okay";
};

&lfxo {
	load-capacitors = "internal";
	load-capacitance-picofarad = <7>;
};

&adc {
	status = "okay";
};

&nfct {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c3 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c3_default>;
	pinctrl-1 = <&i2c3_sleep>;
	pinctrl-names = "default", "sleep";
	gpio_cpu1_bank1: pcal6408a@20 {
		compatible = "nxp,pcal6408a";
		status = "okay";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		reset-gpios = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		int-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		gpio-line-names =
			"DISPON",
			"PSMODE",
			"PSEN",
			"PGOOD",
			"TP1-1",
			"ALERT1",
			"ALERT2",
			"TP1-2";
	};
	cpu1_adc0: ads1115@48 {
		status = "okay";
		compatible = "ti,ads1115";
		reg = <0x48>;
//		alert-rdy-gpios = <&gpio_cpu1_bank1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		label = "ADS1115 U8";
		#io-channel-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		/* internally this ADC only has one converter, to select */
		/*  different pins, we need to set the MUX infront of the converter */
		channel@0 {
			reg = <0>;
			zephyr,gain = "ADC_GAIN_1_2"; /* gain of 1/2 */
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
			zephyr,resolution = < 15 >;
		};
	};
	cpu1_adc1: ads1115@49 {
		status = "okay";
		compatible = "ti,ads1115";
		reg = <0x49>;
//		alert-rdy-gpios = <&gpio_cpu1_bank1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		label = "ADS1115 U9";
		#io-channel-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		/* internally this ADC only has one converter, to select */
		/*  different pins, we need to set the MUX infront of the converter */
		channel@0 {
			reg = <0>;
			zephyr,gain = "ADC_GAIN_1_2"; /* gain of 1/2 */
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
			zephyr,resolution = < 15 >;
		};
	};
};

/ {
	zephyr,user {
		/* adjust channel number according to pinmux in board.dts */
		io-channels = <&cpu1_adc0 0>, <&cpu1_adc1 0>;
	};
};


