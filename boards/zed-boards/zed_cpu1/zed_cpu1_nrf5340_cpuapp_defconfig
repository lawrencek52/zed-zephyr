# Enable MPU
CONFIG_ARM_MPU=y

# Enable TrustZone-M
CONFIG_ARM_TRUSTZONE_M=y

# enable GPIO
CONFIG_GPIO=y

# Enable uart driver
CONFIG_SERIAL=y

# enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# enable i2c3 for the housekeeping
CONFIG_I2C=y
CONFIG_I2C_NRFX=y

#enable the housekeeping adcs
CONFIG_ADC=y
